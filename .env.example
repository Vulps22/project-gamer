# Copy to .env.development / .env.staging / .env.production. Never commit a real one.
ENVIRONMENT=dev

# Discord
DISCORD_TOKEN=
CLIENT_ID=

# PostgreSQL: the native install on the VPS (dev reaches it through an SSH tunnel).
# The same users as PE, in dev and prod; only the database differs.
DB_HOST=127.0.0.1
DB_PORT=49154
DB_NAME=project-gamer-dev
DB_USER=bot_user
DB_PASSWORD=
# Migrations only
DB_ROLLOUT_USER=awesome_vd_user
DB_ROLLOUT_PASSWORD=
# The analytics tool
DB_ANALYTICS_USER=analytics_user
DB_ANALYTICS_PASSWORD=
